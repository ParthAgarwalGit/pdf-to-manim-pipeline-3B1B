# Copy to keys.env and fill in. keys.env is git-ignored and Docker-ignored.
#
# V2 needs one key. GEMINI_API_KEY (from Google AI Studio) drives every paid stage:
#   low-confidence OCR, lesson plan, narration, narration review, Manim code generation,
#   screenshot-guided repair, narration TTS (Gemini TTS, voice Sulafat) and the presenter.
# Model ids live in src/pipeline_v2/model_config.py.
# Without the key, each stage uses a deterministic local fallback (silent timing audio for
# narration) unless pdf2manim is run with --strict-keys.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini TTS requests per minute for this project (default 10, the Tier 1 quota).
# Narration sends one request per beat; raise this on a higher tier to record faster.
# GEMINI_TTS_RPM=10

# Optional: only for --tts-provider openai, or the legacy V1 pipeline.
# OPENAI_API_KEY=your_openai_api_key_here

# Optional legacy V1 provider; V2 does not use Claude.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional legacy: D-ID talking-professor backend (--render-backend did-avatar).
# D_ID_API_KEY is accepted as a legacy alias.
# DID_API_KEY=your_d_id_api_key_here

# Optional: web-demo port (defaults to 7860)
# PORT=7860
