# Copy to keys.env and fill in. keys.env is git-ignored and Docker-ignored.
#
# V2's task-tiered provider defaults:
#   OPENAI_API_KEY    -> TTS
#   GEMINI_API_KEY    -> lesson, narration, low-confidence OCR, Manim generation, vision repair
# Without a key, the corresponding stage uses a deterministic local fallback
# unless pdf2manim is run with --strict-keys.
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional legacy V1 provider; V2 does not use Claude.
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: D-ID talking-professor backend (--render-backend did-avatar).
# D_ID_API_KEY is accepted as a legacy alias.
# DID_API_KEY=your_d_id_api_key_here

# Optional: web-demo port (defaults to 7860)
# PORT=7860
