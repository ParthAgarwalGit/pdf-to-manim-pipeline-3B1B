# Copy to keys.env and fill in. keys.env is git-ignored and Docker-ignored.
#
# All three keys are needed for every production provider path:
#   OPENAI_API_KEY    -> vision/OCR, script, storyboard grading, video QA, TTS (gpt-5 / tts)
#   ANTHROPIC_API_KEY -> unified whole-document script generation (claude)
#   GEMINI_API_KEY    -> Manim Python code generation (Gemini 3.7 Flash)
# Without a key, the corresponding stage falls back to deterministic mock output.
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: D-ID talking-professor backend (--render-backend did-avatar).
# D_ID_API_KEY is accepted as a legacy alias.
# DID_API_KEY=your_d_id_api_key_here

# Optional: web-demo port (defaults to 7860)
# PORT=7860
